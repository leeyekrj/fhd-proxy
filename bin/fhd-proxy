#!/usr/bin/env python3
# fhd-proxy by leeyekrj
"""Create verified, aspect-preserving 10-bit HEVC editing proxies. MIT."""
import argparse
import concurrent.futures
import json
import math
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import threading

VERSION = "1.0.0"
EXTENSIONS = {".mp4", ".mov", ".m4v", ".mkv", ".mts", ".m2ts"}
CHILDREN = set()
LOCK = threading.Lock()
STOP = threading.Event()


def cancel(signum=None, frame=None):
    STOP.set()
    with LOCK:
        for child in list(CHILDREN):
            try:
                child.terminate()
            except ProcessLookupError:
                pass


def run(args):
    if STOP.is_set():
        raise RuntimeError("취소됨")
    with tempfile.TemporaryFile() as output:
        child = subprocess.Popen(args, stdout=output, stderr=subprocess.STDOUT)
        with LOCK:
            CHILDREN.add(child)
        try:
            while True:
                try:
                    child.wait(timeout=0.25)
                    break
                except subprocess.TimeoutExpired:
                    if STOP.is_set():
                        child.terminate()
                        try:
                            child.wait(timeout=3)
                        except subprocess.TimeoutExpired:
                            child.kill()
                            child.wait()
                        raise RuntimeError("취소됨")
            output.seek(0)
            data = output.read().decode("utf-8", "replace")
            if child.returncode:
                raise RuntimeError(data[-3000:] or "외부 도구 실행 실패")
            return data
        finally:
            with LOCK:
                CHILDREN.discard(child)


def probe(path):
    return json.loads(run(["ffprobe", "-v", "error", "-show_format", "-show_streams", "-of", "json", str(path)]))


def video(info):
    return next(s for s in info["streams"] if s["codec_type"] == "video" and not s.get("disposition", {}).get("attached_pic"))


def duration(info):
    return float(info["format"].get("duration") or video(info).get("duration") or 0)


def dimensions(w, h):
    ratio = min(1, 1920 / w, 1080 / h)
    return max(2, int(w * ratio) // 2 * 2), max(2, int(h * ratio) // 2 * 2)


def color_options(v):
    flags = []
    for key, option in (("color_range", "-color_range"), ("color_primaries", "-color_primaries"),
                        ("color_transfer", "-color_trc"), ("color_space", "-colorspace")):
        value = v.get(key)
        if value and value not in ("unknown", "unspecified", "reserved"):
            flags += [option, value]
    # VideoToolbox may replace pc with tv; patch the HEVC VUI, without guessing primaries.
    if v.get("color_range") in ("pc", "tv"):
        flags += ["-bsf:v", "hevc_metadata=video_full_range_flag=" + ("1" if v["color_range"] == "pc" else "0")]
    return flags


def convert(src, dst, args):
    if dst.exists():
        raise RuntimeError(f"이미 있는 출력은 덮어쓰지 않습니다: {dst}")
    info = probe(src)
    v = video(info)
    original_duration = duration(info)
    if not math.isfinite(original_duration) or original_duration <= 0:
        raise RuntimeError("영상 길이를 확인할 수 없습니다")
    w, h = dimensions(int(v["width"]), int(v["height"]))
    dst.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".fhd-proxy-", dir=dst.parent) as tmp:
        part = Path(tmp) / "output.mov"
        command = ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-noautorotate", "-i", str(src),
                   "-map", f"0:{v['index']}", "-map", "0:a?", "-map_metadata", "0", "-map_chapters", "0",
                   "-vf", f"scale={w}:{h}:flags=lanczos", "-c:v", args.encoder, "-pix_fmt", "p010le" if args.encoder == "hevc_videotoolbox" else "yuv420p10le",
                   "-profile:v", "main10", "-tag:v", "hvc1", "-g", "12"]
        if args.encoder == "hevc_videotoolbox":
            command += ["-q:v", str(args.quality), "-allow_sw", "0"]
        else:
            command += ["-crf", "22", "-preset", "fast", "-x265-params", "pools=2:frame-threads=2"]
        command += color_options(v) + ["-c:a", "copy", "-movflags", "+faststart", str(part)]
        run(command)
        result = probe(part)
        rv = video(result)
        if abs(duration(result) - original_duration) > max(.15, 2 / 24):
            raise RuntimeError("길이 검증 실패")
        if (rv["width"], rv["height"]) != (w, h) or rv.get("profile") != "Main 10":
            raise RuntimeError("해상도·10bit 검증 실패")
        for key in ("color_range", "color_primaries", "color_transfer", "color_space"):
            if v.get(key) not in (None, "unknown", "unspecified", "reserved") and rv.get(key) != v[key]:
                raise RuntimeError(f"색 정보 검증 실패: {key}")
        if sum(s["codec_type"] == "audio" for s in info["streams"]) != sum(s["codec_type"] == "audio" for s in result["streams"]):
            raise RuntimeError("오디오 트랙 검증 실패")
        timecode = v.get("tags", {}).get("timecode") or info["format"].get("tags", {}).get("timecode")
        if timecode and not any(s.get("tags", {}).get("timecode") == timecode for s in result["streams"]):
            raise RuntimeError("타임코드 검증 실패")
        if STOP.is_set():
            raise RuntimeError("취소됨")
        # link is an atomic, no-overwrite commit on the destination filesystem.
        os.link(part, dst)
    return f"완료: {src.name} → {dst} ({w}×{h}, {dst.stat().st_size / 1e6:.1f} MB)"


def jobs(inputs, output):
    sources = []
    for item in inputs:
        path = Path(item).expanduser().resolve(strict=True)
        candidates = sorted(path.iterdir()) if path.is_dir() else [path]
        sources += [p for p in candidates if p.is_file() and p.suffix.lower() in EXTENSIONS and not p.name.startswith("._")]
    sources = list(dict.fromkeys(sources))
    pairs = [(p, (Path(output).expanduser().resolve() if output else p.parent / "Proxy") / (p.stem + ".mov")) for p in sources]
    destinations = set()
    for src, dst in pairs:
        key = str(dst).casefold()
        if key in destinations or src == dst:
            raise ValueError(f"출력 이름 충돌: {dst}. 입력별 출력 폴더를 나누세요.")
        destinations.add(key)
    if not pairs:
        raise ValueError("처리할 영상 파일이 없습니다")
    return pairs


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("inputs", nargs="+")
    p.add_argument("--output", "-o")
    p.add_argument("--quality", type=int, default=75, choices=range(1, 101), metavar="1..100")
    p.add_argument("--jobs", type=int, default=2, choices=range(1, 9), metavar="1..8")
    p.add_argument("--encoder", choices=("hevc_videotoolbox", "libx265"), default="hevc_videotoolbox")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--version", action="version", version=VERSION)
    args = p.parse_args()
    try:
        pairs = jobs(args.inputs, args.output)
        if args.dry_run:
            for src, dst in pairs:
                print(f"{src} → {dst}" + (" [존재함: 처리 안 함]" if dst.exists() else ""))
            return 0
        for tool in ("ffmpeg", "ffprobe"):
            if not shutil.which(tool):
                raise ValueError(f"{tool}가 없습니다. macOS: brew install ffmpeg")
        signal.signal(signal.SIGINT, cancel)
        signal.signal(signal.SIGTERM, cancel)
        failures = 0
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
            futures = {pool.submit(convert, s, d, args): s for s, d in pairs}
            for future in concurrent.futures.as_completed(futures):
                try:
                    print(future.result(), flush=True)
                except Exception as exc:
                    failures += 1
                    print(f"실패: {futures[future].name}: {exc}", file=sys.stderr, flush=True)
        return 130 if STOP.is_set() else (1 if failures else 0)
    except (OSError, ValueError, StopIteration) as exc:
        print(f"fhd-proxy: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
